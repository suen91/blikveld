/2010/main" val="0"/></a:ext></a:extLst></a:blip><a:srcRect/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr bwMode="auto"><a:xfrm><a:off x="0" y="0"/><a:ext cx="5758815" cy="3240405"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="18938A86" w14:textId="73D532A1" w:rsidR="00870584" w:rsidRDefault="00870584" w:rsidP="00870584"><w:r><w:t xml:space="preserve">Er kan nog een auto achter de vrachtwagen aanrijden. Door de bosjes en bomen aan de rechterkant kunnen jij en deze auto elkaar minder goed zien. </w:t></w:r></w:p><w:p w14:paraId="02ACC5FA" w14:textId="77777777" w:rsidR="00870584" w:rsidRDefault="00870584" w:rsidP="00870584"/><w:p w14:paraId="110C9FA2" w14:textId="77777777" w:rsidR="00870584" w:rsidRDefault="00870584" w:rsidP="00870584"/><w:p w14:paraId="485503AE" w14:textId="77777777" w:rsidR="00870584" w:rsidRDefault="00870584" w:rsidP="00870584"/><w:p w14:paraId="425AD82C" w14:textId="7372409B" w:rsidR="00870584" w:rsidRDefault="00870584" w:rsidP="00870584"><w:r w:rsidRPr="00870584"><w:t>Blikveld_1-</w:t></w:r><w:r><w:t>4</w:t></w:r><w:r w:rsidRPr="00870584"><w:t>.jpg</w:t></w:r></w:p><w:p w14:paraId="0C59C140" w14:textId="330BA26E" w:rsidR="00870584" w:rsidRDefault="00870584" w:rsidP="00870584"><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="7183AC51" wp14:editId="658DFBC0"><wp:extent cx="5758815" cy="3240405"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="131136797" name="Afbeelding 5"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.